<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent"
    android:layout_height="match_parent" android:gravity="center" android:orientation="vertical"
    android:padding="6dp" android:background="#172743">
    <TextView android:id="@+id/widget_open" android:layout_width="match_parent" android:layout_height="0dp"
        android:layout_weight="1" android:gravity="center" android:textColor="#FFFFFF" android:text="助手" />
    <TextView android:id="@+id/widget_stop" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:minHeight="28dp" android:gravity="center" android:textColor="#FFFFFF" android:text="停止" />
</LinearLayout>
